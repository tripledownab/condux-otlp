<Project>

  <!-- Shared authoring and packaging metadata. Version defaults to the current development value and is
       overridden in CI from the release tag. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Condux</Authors>
    <Company>Condux</Company>
    <PackageProjectUrl>https://github.com/tripledownab/condux-otlp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tripledownab/condux-otlp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The icon has to travel inside the package: PackageIconUrl is deprecated and nuget.org will not
         render it. Packed from here so every package in the repository carries the same mark. -->
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
